CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Do NOT commit real credentials — set via 'idf.py menuconfig' locally
CONFIG_DEVICE_WIFI_SSID=""
CONFIG_DEVICE_WIFI_PASSWORD=""
CONFIG_DEVICE_HUB_BASE_URL="https://www.wangyutang.cn/devices/api"
CONFIG_DEVICE_ID="esp32-s3-walle"
CONFIG_DEVICE_NAME="WALLE ESP32"
CONFIG_DEVICE_FIRMWARE_VERSION="esp32-wangyutang-v28-duckable"
# The bundled ESP-IDF Wi-Fi library lacks the WPA3 RSNXE symbol; this device
# uses WPA2-PSK and does not need WPA3 support for the v1 integration.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_ENABLE_SAE_H2E=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# Disable USB-JTAG console to free GPIO 5-8 for LCD (D4-D7)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0

# Enable octal PSRAM (8MB, AP_3v3) -- confirmed present on hardware but never
# turned on before; needed for run_mic_asr_test's mic-buffer allocations.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# esp-sr AFE is compute-heavy: full clock + 1 kHz tick.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
