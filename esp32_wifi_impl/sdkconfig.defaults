CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Do NOT commit real credentials — set via 'idf.py menuconfig' locally
CONFIG_DEVICE_WIFI_SSID=""
CONFIG_DEVICE_WIFI_PASSWORD=""
CONFIG_DEVICE_HUB_BASE_URL="https://www.wangyutang.cn/devices/api"
CONFIG_DEVICE_ID="esp32-s3-walle"
CONFIG_DEVICE_NAME="WALLE ESP32"
CONFIG_DEVICE_FIRMWARE_VERSION="esp32-wangyutang-v1"
